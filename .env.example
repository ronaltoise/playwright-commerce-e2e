# Copy to .env for local overrides. Everything has a default, so a plain `npm test` needs none of this.

# Point the suites at a shop that is already running, instead of the ones Playwright starts.
# E2E_STABLE_URL=http://localhost:4173
# E2E_BUGGY_URL=http://localhost:4174

# Only used by the nightly's report job. Without them the report makes no network calls.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/name
# CHAT_WEBHOOK_URL=
